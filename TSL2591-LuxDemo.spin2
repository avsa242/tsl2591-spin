{
----------------------------------------------------------------------------------------------------
    Filename:       TSL2591-LuxDemo.spin2
    Description:    Demo of the TSL2591 driver
        * Lux data output
    Author:         Jesse Burt
    Started:        Jul 23, 2022
    Updated:        Jun 2, 2024
    Copyright (c) 2024 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = cfg._clkfreq_def
    _xtlfreq    = cfg._xtlfreq

' -- User-modifiable constants
    GA          = 1                             ' Glass attenuation factor
    DF          = 408                           ' Device factor
' --


OBJ

    cfg:    "boardcfg.p2eval"
    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    sensor:  "sensor.light.tsl2591" | SCL=0, SDA=1, I2C_FREQ=400_000


PUB setup()

    ser.start()
    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"TSL2591 driver started")
    else
        ser.strln(@"TSL2591 driver failed to start - halting")
        repeat

    sensor.preset_als()

    sensor.glass_atten(GA)
    sensor.dev_factor(DF)
    demo()

#include "luxdemo.common.spin2h"                ' code common to all lux demos


DAT
